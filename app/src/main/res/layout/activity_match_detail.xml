<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        android:background="@android:color/transparent"
        app:elevation="0dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header_gradient"
            android:paddingBottom="32dp"
            app:layout_scrollFlags="scroll|enterAlways">

            <!-- Decorative circle top-right -->
            <View
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:layout_alignParentTop="true"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="-40dp"
                android:layout_marginEnd="-40dp"
                android:alpha="0.05"
                android:background="@drawable/bg_avatar_circle" />

            <!-- Decorative circle bottom-left -->
            <View
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_alignParentStart="true"
                android:layout_alignParentBottom="true"
                android:layout_marginStart="-30dp"
                android:layout_marginBottom="-30dp"
                android:alpha="0.03"
                android:background="@drawable/bg_avatar_circle" />

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:title="" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/toolbar"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingTop="8dp">

                <FrameLayout
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_avatar_circle"
                    android:backgroundTint="#33FFFFFF">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="⚙️"
                        android:textSize="28sp" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Chi tiết trận đấu"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF" />

                    <TextView
                        android:id="@+id/tvTournamentName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tên giải đấu"
                        android:textSize="14sp"
                        android:textColor="#E0E0E0"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </LinearLayout>
        </RelativeLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:layout_marginTop="-24dp">

            <!-- CARD 1: SETUP -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#FFFFFF"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CÀI ĐẶT TRẬN ĐẤU"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#7B9C7F"
                        android:letterSpacing="0.1"
                        android:layout_marginBottom="16dp" />

                    <!-- Teams Setup -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">
                        <TextView
                            android:layout_width="60dp"
                            android:layout_height="wrap_content"
                            android:text="Đội 1:"
                            android:textColor="#1B2A1D"
                            android:textStyle="bold" />
                        <Spinner
                            android:id="@+id/spinnerTeam1"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_edittext" />
                    </LinearLayout>
                    
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">
                        <TextView
                            android:layout_width="60dp"
                            android:layout_height="wrap_content"
                            android:text="Đội 2:"
                            android:textColor="#1B2A1D"
                            android:textStyle="bold" />
                        <Spinner
                            android:id="@+id/spinnerTeam2"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_edittext" />
                    </LinearLayout>

                    <!-- Date & Time -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">
                        
                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            app:boxCornerRadiusTopStart="8dp"
                            app:boxCornerRadiusTopEnd="8dp"
                            app:boxCornerRadiusBottomStart="8dp"
                            app:boxCornerRadiusBottomEnd="8dp"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etDate"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Ngày (DD/MM)" />
                        </com.google.android.material.textfield.TextInputLayout>
                        
                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            app:boxCornerRadiusTopStart="8dp"
                            app:boxCornerRadiusTopEnd="8dp"
                            app:boxCornerRadiusBottomStart="8dp"
                            app:boxCornerRadiusBottomEnd="8dp"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etTime"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Giờ (HH:MM)" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <!-- Location & Referee -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        app:boxCornerRadiusTopStart="8dp"
                        app:boxCornerRadiusTopEnd="8dp"
                        app:boxCornerRadiusBottomStart="8dp"
                        app:boxCornerRadiusBottomEnd="8dp"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etLocation"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Địa điểm / Sân thi đấu" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:boxCornerRadiusTopStart="8dp"
                        app:boxCornerRadiusTopEnd="8dp"
                        app:boxCornerRadiusBottomStart="8dp"
                        app:boxCornerRadiusBottomEnd="8dp"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etReferee"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Trọng tài (Tùy chọn)" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- CARD 2: KẾT QUẢ & TRẠNG THÁI -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#FFFFFF"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="KẾT QUẢ TRẬN ĐẤU"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#7B9C7F"
                        android:letterSpacing="0.1"
                        android:layout_marginBottom="20dp" />

                    <!-- Scores layout -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:id="@+id/tvDisplayTeam1"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Đội 1"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#1B2A1D"
                            android:gravity="center" />

                        <TextView
                            android:id="@+id/etScore1"
                            android:layout_width="60dp"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="28sp"
                            android:textStyle="bold"
                            android:textColor="#2E7D32"
                            android:gravity="center"
                            android:background="@drawable/bg_edittext"
                            android:padding="8dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="-"
                            android:textSize="28sp"
                            android:textStyle="bold"
                            android:textColor="#9E9E9E"
                            android:layout_marginHorizontal="12dp" />

                        <TextView
                            android:id="@+id/etScore2"
                            android:layout_width="60dp"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="28sp"
                            android:textStyle="bold"
                            android:textColor="#2E7D32"
                            android:gravity="center"
                            android:background="@drawable/bg_edittext"
                            android:padding="8dp" />

                        <TextView
                            android:id="@+id/tvDisplayTeam2"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Đội 2"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#1B2A1D"
                            android:gravity="center" />
                    </LinearLayout>

                    <!-- Penalty layout -->
                    <LinearLayout
                        android:id="@+id/layoutPenalty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="(Luân lưu)"
                            android:textSize="12sp"
                            android:gravity="end"
                            android:paddingEnd="8dp" />

                        <EditText
                            android:id="@+id/etPenalty1"
                            android:layout_width="40dp"
                            android:layout_height="wrap_content"
                            android:hint="-"
                            android:textSize="16sp"
                            android:textColor="#E65100"
                            android:gravity="center"
                            android:inputType="number"
                            android:background="@drawable/bg_edittext"
                            android:padding="4dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="-"
                            android:textSize="16sp"
                            android:layout_marginHorizontal="8dp" />

                        <EditText
                            android:id="@+id/etPenalty2"
                            android:layout_width="40dp"
                            android:layout_height="wrap_content"
                            android:hint="-"
                            android:textSize="16sp"
                            android:textColor="#E65100"
                            android:gravity="center"
                            android:inputType="number"
                            android:background="@drawable/bg_edittext"
                            android:padding="4dp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="(Luân lưu)"
                            android:textSize="12sp"
                            android:gravity="start"
                            android:paddingStart="8dp" />
                    </LinearLayout>

                    <!-- Tóm tắt sự kiện 2 bên -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="16dp">

                        <!-- Sự kiện Đội 1 (bên trái, align phải) -->
                        <LinearLayout
                            android:id="@+id/layoutTeam1Events"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="end"
                            android:paddingEnd="8dp" />

                        <!-- Đường phân cách giữa -->
                        <View
                            android:layout_width="1dp"
                            android:layout_height="match_parent"
                            android:background="#E0E0E0" />

                        <!-- Sự kiện Đội 2 (bên phải, align trái) -->
                        <LinearLayout
                            android:id="@+id/layoutTeam2Events"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="start"
                            android:paddingStart="8dp" />
                    </LinearLayout>

                    <Spinner
                        android:id="@+id/spinnerStatus"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_edittext"
                        android:textAlignment="center" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- CARD 3: DIỄN BIẾN TRẬN ĐẤU -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#FFFFFF"
                android:layout_marginBottom="32dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DIỄN BIẾN TRẬN ĐẤU"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#7B9C7F"
                        android:letterSpacing="0.1"
                        android:layout_marginBottom="16dp" />
                        
                    <LinearLayout
                        android:id="@+id/layoutEventsContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                        
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp"
                        android:gravity="center">
                        
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnAddGoal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="+ Bàn thắng"
                            android:textSize="12sp"
                            android:textColor="#2E7D32"
                            app:strokeColor="#2E7D32"
                            android:layout_marginEnd="8dp"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
                            
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnAddCard"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="+ Thẻ phạt"
                            android:textSize="12sp"
                            android:textColor="#D32F2F"
                            app:strokeColor="#D32F2F"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Nút Cập nhật -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUpdateMatch"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Lưu thông tin"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                app:backgroundTint="#2E7D32"
                app:cornerRadius="12dp"
                android:layout_marginBottom="16dp" />

            <!-- Nút Xóa -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDeleteMatch"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Xóa trận đấu"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#D32F2F"
                app:backgroundTint="@android:color/transparent"
                app:strokeColor="#D32F2F"
                app:strokeWidth="1dp"
                app:cornerRadius="12dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_marginBottom="32dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>

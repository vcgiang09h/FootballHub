<?xml version="1.0" encoding="utf-8"?>
<!--
    item_tournament.xml
    Card giải đấu: tên, hình thức, trạng thái, số đội
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp"
    android:layout_marginTop="5dp"
    android:layout_marginBottom="5dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="@color/card_bg"
    app:rippleColor="#1AFF8F00">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top row: icon + tên + badge trạng thái -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Trophy icon -->
            <TextView
                android:id="@+id/tvTournamentIcon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="🏆"
                android:textSize="24sp"
                android:gravity="center"
                android:background="@drawable/bg_icon_circle_amber" />

            <!-- Tên + hình thức -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingEnd="8dp">

                <TextView
                    android:id="@+id/tvTournamentName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Giải bóng đá sinh viên"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tvTournamentFormat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Đá loại trực tiếp"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- Badge trạng thái -->
            <TextView
                android:id="@+id/tvTournamentStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sắp diễn ra"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#E65100"
                android:background="@drawable/bg_status_badge"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp" />

        <!-- Bottom row: ngày bắt đầu + số đội -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Ngày bắt đầu -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📅 "
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvTournamentDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="01/06/2026"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>

            <!-- Số đội -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="👥 "
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvTournamentTeams"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0/8 đội"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
